{
  "name": "mystery-watch-r3f",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "expo start --dev-client",
    "--": "--------------",
    "iosPrebuild": "expo prebuild --platform ios --clean",
    "androidPrebuild": "expo prebuild --platform android --clean",
    "---": "--------------",
    "iosRun": "expo run:ios",
    "iosRunIPhone17": "expo run:ios --device \"iPhone 17\"",
    "iosRunRelease": "expo run:ios --configuration Release --no-bundler",
    "androidRun": "expo run:android",
    "androidRunMediumPhone": "expo run:android --device \"Medium_Phone_API_37.0\"",
    "androidRunRelease": "expo run:android --variant release --no-bundler",
    "----": "--------------",
    "iosRestart": "bash scripts/app/restartIos.sh",
    "androidEmulatorStart": "bash scripts/app/startAndroidEmulator.sh",
    "androidEmulatorStop": "adb emu kill",
    "androidRestart": "bash scripts/app/restartAndroid.sh",
    "androidRestartRelease": "bash scripts/app/restartAndroid.sh release",
    "-----": "--------------",
    "perfIosFps": "bash scripts/perf/measureRenderFps.sh ios",
    "perfAndroidPresentFps": "bash scripts/perf/measureAndroidPresentFps.sh",
    "androidRunCatalogueScroll": "EXPO_PUBLIC_AUTO_SCROLL=1 EXPO_PUBLIC_SHOW_PERFORMANCE=1 expo run:android --variant release --no-bundler",
    "iosRunCatalogueScroll": "EXPO_PUBLIC_AUTO_SCROLL=1 EXPO_PUBLIC_SHOW_PERFORMANCE=1 EXPO_PUBLIC_PERF_SINK_URL=http://localhost:8787 expo run:ios --configuration Release --no-bundler",
    "perfAndroidCatalogue": "bash scripts/perf/runCatalogueScroll.sh android",
    "perfIosCatalogue": "bash scripts/perf/runCatalogueScroll.sh ios",
    "androidRunOpening": "EXPO_PUBLIC_SHOW_PERFORMANCE=1 expo run:android --variant release --no-bundler",
    "iosRunOpening": "EXPO_PUBLIC_SHOW_PERFORMANCE=1 EXPO_PUBLIC_PERF_SINK_URL=http://localhost:8787 expo run:ios --configuration Release --no-bundler",
    "perfAndroidOpening": "bash scripts/perf/captureOpeningFlow.sh",
    "perfCharts": "python3 scripts/perf/renderCharts.py",
    "perfAndroidFps": "bash scripts/perf/measureRenderFps.sh android",
    "perfSinkStart": "bash scripts/perf/perfSinkControl.sh start",
    "perfSinkStop": "bash scripts/perf/perfSinkControl.sh stop",
    "perfIosProfile": "bash scripts/perf/captureIosProfile.sh",
    "perfAndroidTrace": "bash scripts/perf/captureAndroidTrace.sh",
    "perfIosAll": "yarn iosRestart && yarn perfIosFps && yarn perfIosProfile",
    "perfAndroidAll": "yarn androidRestart && yarn perfAndroidFps && yarn perfAndroidTrace",
    "------": "--------------",
    "assetsOptimizeWatches": "bash scripts/assets/optimizeWatchImages.sh",
    "assetsOptimizeBox": "bash scripts/assets/optimizeBoxModel.sh",
    "assetsSounds": "python3 scripts/assets/generateSounds.py",
    "assetsOptimize": "yarn assetsOptimizeWatches && yarn assetsOptimizeBox",
    "-------": "--------------",
    "lint": "eslint .",
    "ts": "tsc -p . --pretty --skipLibCheck --project ./tsconfig.json",
    "test": "jest",
    "ciPipeline": "yarn lint && yarn ts",
    "--------": "--------------",
    "adbR": "adb reverse tcp:8081 tcp:8081",
    "cleanCache": "yarn start --reset-cache",
    "cleanNative": "rm -rf android && rm -rf ios",
    "cleanNode": "rm -rf node_modules && yarn cache clean",
    "cleanAndroid": "cd android && ./gradlew clean && cd ..",
    "cleanIosData": "rm -rf ~/Library/Developer/Xcode/DerivedData",
    "watchman": "watchman watch-del-all",
    "doctor": "npx expo-doctor"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@react-three/fiber": "^9.8.2",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.89.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58",
    "expo-font": "~58.0.12",
    "expo-gl": "~58",
    "expo-haptics": "~58.0.8",
    "expo-localization": "~58.0.5",
    "expo-sensors": "~58.0.5",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "i18next": "^27",
    "immer": "^11",
    "react": "19.3.0",
    "react-i18next": "^18",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-size-matters": "^0.4.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "0.13.0",
    "three": "^0.187.0",
    "uuid": "^14",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/compat": "^2",
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "^0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@stylistic/eslint-plugin": "^6",
    "@tanstack/eslint-plugin-query": "^5.89.0",
    "@testing-library/react-native": "^14",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/three": "^0.187.0",
    "babel-jest": "^30.1.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-filename-rules": "^1.3.1",
    "eslint-plugin-folders": "^1.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^30.1.3",
    "jest-expo": "~58.0.15",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.44.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "\\.wav$": "<rootDir>/__mocks__/assetStub.js",
      "^@app/(.*)$": "<rootDir>/src/app/$1",
      "^@i18next/(.*)$": "<rootDir>/src/i18next/$1",
      "^@configs/(.*)$": "<rootDir>/src/configs/$1",
      "^@assets/(.*)$": "<rootDir>/src/assets/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@flows/(.*)$": "<rootDir>/src/flows/$1",
      "^@models/(.*)$": "<rootDir>/src/models/$1",
      "^@navigation/(.*)$": "<rootDir>/src/navigation/$1",
      "^@networking/(.*)$": "<rootDir>/src/networking/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^immer$": "<rootDir>/node_modules/immer/dist/cjs/index.js"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@shopify/flash-list|three|@react-three/.*)"
    ]
  }
}
